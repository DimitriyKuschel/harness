{
  "name": "harness",
  "displayName": "Harness — AI Team",
  "description": "%description%",
  "version": "0.1.0",
  "publisher": "korsar",
  "repository": {
    "type": "git",
    "url": "https://github.com/DimitriyKuschel/harness.git"
  },
  "homepage": "https://github.com/DimitriyKuschel/harness#readme",
  "bugs": {
    "url": "https://github.com/DimitriyKuschel/harness/issues"
  },
  "private": true,
  "license": "MIT",
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#1f2026",
    "theme": "dark"
  },
  "keywords": [
    "claude",
    "claude code",
    "codex",
    "gemini",
    "antigravity",
    "multi-agent",
    "agents",
    "ai team",
    "brainstorm",
    "code review"
  ],
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "AI",
    "Chat"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "%untrusted.description%",
      "restrictedConfigurations": [
        "harness.agents.claude.path",
        "harness.agents.codex.path",
        "harness.agents.gemini.path"
      ]
    }
  },
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "harness",
          "title": "AI Team",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "harness": [
        {
          "type": "webview",
          "id": "harness.chat",
          "name": "Team"
        }
      ]
    },
    "commands": [
      {
        "command": "harness.newChat",
        "title": "%command.newChat%",
        "category": "Harness",
        "icon": "$(add)"
      },
      {
        "command": "harness.openInEditor",
        "title": "%command.openInEditor%",
        "category": "Harness",
        "icon": "$(link-external)"
      },
      {
        "command": "harness.refreshAgents",
        "title": "%command.refreshAgents%",
        "category": "Harness",
        "icon": "$(refresh)"
      },
      {
        "command": "harness.showLog",
        "title": "%command.showLog%",
        "category": "Harness",
        "icon": "$(output)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "harness.newChat",
          "when": "view == harness.chat",
          "group": "navigation@1"
        },
        {
          "command": "harness.openInEditor",
          "when": "view == harness.chat",
          "group": "navigation@2"
        },
        {
          "command": "harness.refreshAgents",
          "when": "view == harness.chat",
          "group": "overflow@1"
        },
        {
          "command": "harness.showLog",
          "when": "view == harness.chat",
          "group": "overflow@2"
        }
      ]
    },
    "configuration": {
      "title": "Harness",
      "properties": {
        "harness.language": {
          "type": "string",
          "enum": [
            "auto",
            "en",
            "ru"
          ],
          "enumDescriptions": [
            "%config.language.auto%",
            "%config.language.en%",
            "%config.language.ru%"
          ],
          "default": "auto",
          "markdownDescription": "%config.language%"
        },
        "harness.agents.claude.enabled": {
          "type": "boolean",
          "default": true,
          "description": "%config.agents.claude.enabled%"
        },
        "harness.agents.claude.path": {
          "type": "string",
          "default": "claude",
          "description": "%config.agents.claude.path%"
        },
        "harness.agents.claude.chrome": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "%config.agents.claude.chrome%"
        },
        "harness.agents.codex.enabled": {
          "type": "boolean",
          "default": true,
          "description": "%config.agents.codex.enabled%"
        },
        "harness.agents.codex.path": {
          "type": "string",
          "default": "codex",
          "description": "%config.agents.codex.path%"
        },
        "harness.agents.gemini.enabled": {
          "type": "boolean",
          "default": true,
          "description": "%config.agents.gemini.enabled%"
        },
        "harness.agents.gemini.path": {
          "type": "string",
          "default": "agy",
          "description": "%config.agents.gemini.path%"
        },
        "harness.team.maxIterations": {
          "type": "number",
          "default": 5,
          "minimum": 1,
          "maximum": 30,
          "markdownDescription": "%config.team.maxIterations%"
        },
        "harness.team.maxHandoffs": {
          "type": "number",
          "default": 6,
          "minimum": 0,
          "maximum": 30,
          "markdownDescription": "%config.team.maxHandoffs%"
        },
        "harness.routing.classifier": {
          "type": "string",
          "enum": [
            "llm",
            "heuristic"
          ],
          "enumDescriptions": [
            "%config.routing.classifier.llm%",
            "%config.routing.classifier.heuristic%"
          ],
          "default": "llm",
          "description": "%config.routing.classifier%"
        },
        "harness.routing.affinity": {
          "type": "object",
          "description": "%config.routing.affinity%",
          "default": {
            "code": [
              "codex",
              "claude",
              "gemini"
            ],
            "frontend": [
              "claude",
              "gemini",
              "codex"
            ],
            "design": [
              "gemini",
              "claude",
              "codex"
            ],
            "research": [
              "gemini",
              "claude",
              "codex"
            ],
            "writing": [
              "claude",
              "gemini",
              "codex"
            ],
            "marketing": [
              "claude",
              "gemini",
              "codex"
            ],
            "planning": [
              "claude",
              "codex",
              "gemini"
            ],
            "data": [
              "codex",
              "claude",
              "gemini"
            ],
            "other": [
              "claude",
              "codex",
              "gemini"
            ]
          }
        },
        "harness.models": {
          "type": "object",
          "description": "%config.models%",
          "default": {
            "claude": {
              "trivial": {
                "model": "haiku",
                "effort": "low"
              },
              "standard": {
                "model": "sonnet",
                "effort": "medium"
              },
              "hard": {
                "model": "opus",
                "effort": "high"
              },
              "critical": {
                "model": "opus",
                "effort": "xhigh"
              }
            },
            "codex": {
              "trivial": {
                "model": "gpt-6-luna",
                "effort": "low"
              },
              "standard": {
                "model": "gpt-6.1-sol",
                "effort": "medium"
              },
              "hard": {
                "model": "gpt-6.1-sol",
                "effort": "high"
              },
              "critical": {
                "model": "gpt-6-astra",
                "effort": "high"
              }
            },
            "gemini": {
              "trivial": {
                "model": "gemini-3.8-flash-low",
                "effort": "low"
              },
              "standard": {
                "model": "gemini-4-argon-low",
                "effort": "low"
              },
              "hard": {
                "model": "gemini-4-argon-medium",
                "effort": "medium"
              },
              "critical": {
                "model": "gemini-4-argon-high",
                "effort": "high"
              }
            }
          }
        },
        "harness.strengths": {
          "type": "object",
          "description": "%config.strengths%",
          "default": {}
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit -p .",
    "test": "node esbuild.mjs --tests && node --test dist-test/",
    "package": "npm run build -- --production && vsce package --no-dependencies -o harness.vsix"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^20.19.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/vscode": "~1.95.0",
    "@vscode/codicons": "^0.0.40",
    "@vscode/vsce": "^3.6.0",
    "esbuild": "^0.25.0",
    "markdown-it": "^14.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "~5.9.3"
  }
}
